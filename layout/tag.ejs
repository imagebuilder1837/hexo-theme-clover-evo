<h1 class="visually-hidden"><%= clover_page_title() %></h1>
<%_ if (page.tag) { _%>
  <%- partial('_partial/card-list', { posts: page.posts, card_context: 'tag' }) -%>
  <%- partial('_partial/pagination') -%>
<%_ } else { _%>
  <section class="tagcloud">
    <%- tagcloud({
      min_font: 12, 
      max_font: 30, 
      amount: 300, 
      color: true, 
      start_color: '#aaa', 
      end_color: '#333',
      class: 'tag-weight',
      level: 10,
    }) %>
  </section>
<%_ } _%>
