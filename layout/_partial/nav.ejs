<nav id="nav">
  <header class="header">
    <a href="<%= url_for('/') %>" class="title"><%= theme.nav.title %></a>
  </header>
  <div class="ctnWrap">
    <div class="icons">
      <%_ social_links().forEach(function(item) { _%>
        <a href="<%= url_for(item.url) %>" target="_blank" aria-label="<%= item.key %>" class="nav-icn iconfont icon-<%= item.key.toLowerCase() %>"></a>
      <%_ }); _%>
    </div>
    <div class="menu">
      <%_ menu_links().forEach(function(item) { _%>
        <a href="<%= url_for(item.path) %>" class="nav-menu <%= (item.path === '/' ? is_home() : is_current(item.path)) ? 'z-active' : '' %>"><%= item.key.toUpperCase() %></a>
      <%_ }); _%>
    </div>
  </div>
</nav>
