<%- partial('_partial/head') -%>
<%_ const layout = is_home() ? 'home' : is_post() ? 'post' : is_category() ? 'category' : is_tag() ? 'tag' : is_archive() ? 'archive' : page.layout || 'page'; _%>
<body data-layout="<%= layout %>" style="
<%_ if (theme.background.image) { _%>
  background: url(<%= url_for(theme.background.image) %>) center center no-repeat;
  background-size: contain;
<%_ } _%>
<%_ if (theme.background.color) { _%>
  background-color: <%= theme.background.color %>
<%_ } _%>
">
  <div id="container">
    <%- partial('_partial/nav') -%>
    <main id="main"><%- body %></main>
    <%- partial('_partial/footer') -%>
  </div>
</body>
</html>
